# AllSet Identity — environment.
# On Cloud Run these are service environment variables; there is no .env there.
# Real environment variables always win over this file.

# ── Supabase: the call_logs project ──────────────────────────────────────────
# qizrtmvgcwxuycbpkeua (ap-northeast-2) — the same project that holds Broker
# Tools' leads schema. Shared rather than dedicated because the free tier
# allows only two projects.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses RLS and can mint a session for any user. Never expose to a browser.
# Because the project is shared, this key also reaches every lead, note and
# call record in it — not just identity data. Keep it to this service only.
SUPABASE_SERVICE_ROLE_KEY=

# Only set if the project still uses the legacy symmetric JWT secret. New
# projects sign asymmetrically and are verified via JWKS; leave this empty.
SUPABASE_JWT_SECRET=

# Derived from SUPABASE_URL when omitted. Override only for a self-hosted setup.
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# ── Service-to-service ───────────────────────────────────────────────────────
# Guards POST /v1/introspect. Must match the value set on the CMS backend,
# Broker Tools' Django API, Broker Tools' FastAPI service and ai_service.
# Fails closed when unset: introspection refuses every request.
ALLSET_SERVICE_KEY=

# ── Shadow migration of CMS passwords ────────────────────────────────────────
# Lets an existing CMS user's Django PBKDF2 password work once, then upgrades it
# to Supabase. Read-only credentials against the CMS's Supabase project.
# Turn this off (and delete app/legacy.py) once every profile row has
# legacy_migrated_at set. Broker Tools needs none of this — its user store was
# ephemeral SQLite with no durable passwords to migrate.
LEGACY_MIGRATION_ENABLED=false
LEGACY_CMS_DB_HOST=
LEGACY_CMS_DB_PORT=5432
LEGACY_CMS_DB_NAME=postgres
LEGACY_CMS_DB_USER=
LEGACY_CMS_DB_PASSWORD=
LEGACY_CMS_DB_SSLMODE=require

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Browser origins allowed to call the auth endpoints.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
HTTP_TIMEOUT_SECONDS=10

# ── Tunables ─────────────────────────────────────────────────────────────────
# Reported to clients so they can schedule refreshes. The authoritative value is
# set on the Supabase project itself (Authentication -> Sessions) and this only
# mirrors it — changing it here alone changes nothing. 604800 is 7 days, which
# is Supabase's maximum for this setting.
#
# The cost is revocation latency: roles ride in the JWT, so an access token
# already in a browser keeps its roles until it expires. Revoking sessions kills
# refresh tokens immediately but cannot recall an issued access token. See
# app/core/config.py.
ACCESS_TOKEN_TTL_SECONDS=604800

# Sign-in attempts per email per window.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60

IDENTITY_DEBUG=false
